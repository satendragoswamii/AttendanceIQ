# Copy to .env and adjust. .env is gitignored — never commit real secrets.

# --------------------------------------------------------------------------
# Required
# --------------------------------------------------------------------------
# Signs session cookies. If left blank the entrypoint generates one and stores
# it at data/secret_key so logins survive restarts. Changing it logs everyone out.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# --------------------------------------------------------------------------
# Environment
# --------------------------------------------------------------------------
# Controls two things: template caching, and SESSION_COOKIE_SECURE.
#   development -> cookies work over plain http://localhost  (use this locally)
#   production  -> cookies are Secure and require HTTPS       (use behind a TLS proxy)
# Logging in over http:// with FLASK_ENV=production will fail silently.
FLASK_ENV=development

FLASK_DEBUG=false

# Timestamps are stored via datetime.now() and SQLite CURRENT_TIMESTAMP, then
# shifted +5:30 for display. Leave this as UTC or those readings drift.
TZ=UTC

# --------------------------------------------------------------------------
# Optional
# --------------------------------------------------------------------------
# Enables the hidden superadmin password-reset endpoint. Leave blank to keep it
# returning 404. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SUPERADMIN_RESET_KEY=

# Host port to publish the app on.
HOST_PORT=5000

# Gunicorn tuning.
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=180
GUNICORN_LOG_LEVEL=info
